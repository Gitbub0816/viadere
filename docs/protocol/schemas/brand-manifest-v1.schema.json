{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viadere.com/schemas/brand-manifest-v1.schema.json",
  "title": "Viadere brand manifest payload, version 1",
  "description": "Payload of the compact JWS with typ viadere-brand-manifest+jws, signed with the KMS key brand-manifest (SECURITY.md 2.93, ADR-0017). Canonical JSON; ETag = sha256 of the canonical payload. Publish-time rules beyond structure (overlap of equal-priority windows, kit and frame references, content rules on names, asset slot bounds, lifetime) are in ViadereCore BrandManifest.validationIssues. Vectors: docs/protocol/vectors/brand-manifest-v1.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "business_id", "version", "kits", "schedule", "issued_at", "not_after", "kid"],
  "properties": {
    "v": { "const": 1 },
    "business_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "kits": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/kit" } },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["timezone", "windows", "random_pool"],
      "properties": {
        "timezone": { "type": "string", "description": "IANA time zone identifier" },
        "default_kit": { "$ref": "#/$defs/identifier" },
        "windows": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["kit", "starts_at", "priority"],
          "properties": { "kit": { "$ref": "#/$defs/identifier" }, "starts_at": { "$ref": "#/$defs/local" }, "ends_at": { "$ref": "#/$defs/local" },
                          "priority": { "type": "integer", "minimum": 0, "maximum": 1000 } } } },
        "random_pool": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["kit", "weight"],
          "properties": { "kit": { "$ref": "#/$defs/identifier" }, "weight": { "type": "integer", "minimum": 1, "maximum": 100 } } } }
      }
    },
    "issued_at": { "type": "integer" },
    "not_after": { "type": "integer", "description": "at most 30 days after issued_at" },
    "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
    "local": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$", "description": "Wall-clock time in schedule.timezone. Repeated times mean the earlier instant; skipped times are shifted forward by the gap." },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "tokens": {
      "type": "object", "additionalProperties": false, "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/color" }, "secondary": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" },
        "on_primary": { "const": "auto" },
        "radius": { "enum": ["none", "small", "medium", "large"] },
        "border": { "enum": ["none", "hairline", "regular"] },
        "type_scale": { "enum": ["compact", "standard", "large"] }
      },
      "description": "No member for text, links, labels, layout, fonts or protected elements. Colors are clamped by ContrastPolicy."
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "w", "h", "bytes"],
      "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 },
                      "bytes": { "type": "integer", "minimum": 1 } },
      "description": "Served only as https://{ASSET_DOMAIN}/b/{sha256}.png; the device checks the hash before use."
    },
    "kit": {
      "type": "object", "additionalProperties": false, "required": ["kit_id", "name", "tokens"],
      "properties": {
        "kit_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tokens": { "$ref": "#/$defs/tokens" },
        "frame_id": { "type": "string", "description": "A Viadere frame registry id (e.g. viadere.frame.hairline.v1)" },
        "assets": { "type": "object", "additionalProperties": false,
                    "properties": { "logo": { "$ref": "#/$defs/asset" }, "mark": { "$ref": "#/$defs/asset" }, "background": { "$ref": "#/$defs/asset" }, "art": { "$ref": "#/$defs/asset" } } }
      }
    }
  }
}
