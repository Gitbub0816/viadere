<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Viadere</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>$(VIADERE_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Background</string>
		<key>UIImageName</key>
		<string>BrandMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Outfit-Light.ttf</string>
		<string>Outfit-Regular.ttf</string>
		<string>Outfit-SemiBold.ttf</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Viadere uses Face ID to confirm it is you when you approve sign-ins and purchases, and to unlock the app if you turn on app lock.</string>
	<key>NSCameraUsageDescription</key>
	<string>Viadere uses the camera to scan QR codes that connect you to a business. If you choose to scan an ID document, the camera also takes a photo of it and a selfie for that check. They go to our verification provider, not to Viadere.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>If you choose to scan an ID document, the verification provider records a short liveness video with sound to confirm you are present. It is deleted after the check.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>If you choose to scan an ID document, you can pick a photo of it from your library instead of using the camera. Viadere does not read your other photos.</string>
	<key>NSIdentityUsageDescription</key>
	<string>Apple Wallet asks you to confirm before sharing from your ID. Viadere asks only for what a business needs for the request you approve, such as whether you meet an age threshold.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.viadere.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>viadere</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>ViadereAPIBaseURL</key>
	<string>$(VIADERE_API_BASE_URL)</string>
	<key>ViadereAPIPins</key>
	<string>$(VIADERE_API_PINS)</string>
	<key>ViadereAPNsEnvironment</key>
	<string>$(VIADERE_APNS_ENVIRONMENT)</string>
	<key>ViadereRelyingPartyID</key>
	<string>$(VIADERE_RP_DOMAIN)</string>
	<key>ViadereLinkDomain</key>
	<string>$(VIADERE_LINK_DOMAIN)</string>
	<key>ViadereLinkDescriptorKeys</key>
	<string>$(VIADERE_LINK_DESCRIPTOR_KEYS)</string>
	<key>ViadereKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.viadere.shared</string>
	<key>ViadereVaultKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.viadere.vault</string>
	<key>ViadereKeyDirectoryLogKeys</key>
	<string>$(VIADERE_KEY_DIRECTORY_LOG_KEYS)</string>
	<key>ViadereApprovalKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.viadere.app.approval</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
#ifdef VIADERE_LOCAL_DEV
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
#endif
	</dict>
</dict>
</plist>
