# Copy to .env and fill in. NEVER commit a real .env, .p8 key or auth token.
# Generate secrets with:   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

# REQUIRED. development | test | staging | production. A missing or misspelled value is a startup error (it never silently
# becomes "development"). `staging` and `production` make every secret below mandatory, require https, and refuse `seed`.
# Even in development, setting DATABASE_URL makes every secret below mandatory: an ephemeral secret would make stored data
# unreadable after a restart.
ENVIRONMENT=development

# --- Database ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
# docker-compose derives DATABASE_URL from the password above. For other setups set it yourself:
# DATABASE_URL=postgres://viadere:PASSWORD@host:5432/viadere
AUTO_MIGRATE=true

# --- Secrets (base64url, >= 32 bytes each; independent random values) -----------------------------
# HMAC key for signed connect links (QR / buttons).
CONNECT_LINK_SIGNING_KEY=
# Pepper for OTP hashes, phone-number lookup hashes and per-business pseudonyms.
SERVER_PEPPER=
# AES-256-GCM key for phone numbers, message bodies, webhook secrets and SMS conversation state.
# Losing this key makes that data unreadable; rotating it needs a re-encryption job.
DATA_ENCRYPTION_KEY=
# HMAC key of the audit hash chain. Required in staging/production. Keep it OUT of the database (and a different value from the
# secrets above): it is what stops someone who can write the database from recomputing a forged audit chain. Export the chain head
# to write-once storage on a schedule:  ViadereServer audit-head   (verify with:  ViadereServer audit-verify --head head.json)
AUDIT_CHAIN_KEY=

# --- Public URL / passkeys -------------------------------------------------------------------------
PUBLIC_BASE_URL=https://viadere.com
RP_ID=viadere.com
RP_NAME=Viadere
# Outside development RP_ORIGIN must be an https origin of RP_ID (for example https://viadere.com or https://app.viadere.com).
RP_ORIGIN=https://viadere.com
# 10-character Apple Developer Team ID (served in /.well-known/apple-app-site-association).
APPLE_TEAM_ID=
# Numeric App Store id; enables the Smart App Banner on /c/{code}.
APP_STORE_ID=

# --- Device integrity (Apple App Attest) ----------------------------------------------------------------
# What to do with an enrollment that has no valid App Attest attestation: off | report | require.
#   require (the DEFAULT in staging/production): an unattested app or App Clip device is refused (403 attestation_required).
#   report: accepted, flagged in the audit log and cooled down for 72 h instead of 24 h. Use while rolling out the attesting app.
#   off (the default elsewhere): attestations are verified when sent, never required.
# Verification trusts only Apple's App Attestation Root CA (embedded, fingerprint-checked); it cannot be replaced by configuration.
# Needs APPLE_TEAM_ID above (mandatory in staging/production).
APP_ATTEST_MODE=off
# Which App Attest environment the app's builds attest in: development | production. TestFlight and App Store builds use production;
# Xcode debug builds use development. Default: production in production, development elsewhere.
APP_ATTEST_ENVIRONMENT=development

# --- Push (APNs token auth) -------------------------------------------------------------------------
# Either paste the .p8 contents (use \n for newlines) or mount the file and give its path.
APNS_KEY_P8=
# APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.viadere.app
# sandbox | production
APNS_ENVIRONMENT=sandbox

# --- SMS provider (Twilio-compatible) ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- RCS Business Messaging (generic RBM-style provider; leave unset to disable RCS -> SMS only) ----------
# Provider API origin (https in production), bearer token, agent id, and the shared secret (base64url, >= 32 bytes)
# used to verify the inbound webhook HMAC (X-RCS-Signature: t=...,v1=...).
RCS_PROVIDER_BASE_URL=
RCS_PROVIDER_TOKEN=
RCS_AGENT_ID=
RCS_WEBHOOK_SECRET=
# Apple Messages for Business is a non-functional placeholder. Keep this false until Apple approves multi-merchant brokerage in writing.
FEATURE_APPLE_MESSAGES_FOR_BUSINESS=false

# --- Verification codes (toll-fraud defence) -------------------------------------------------------------
# Destination countries (ISO regions) a verification code may be texted to. Default US,CA. Caribbean +1 countries (JM, DO, ...) are
# separate regions and must be listed explicitly.
OTP_ALLOWED_COUNTRIES=US,CA

# --- SMS thread ---------------------------------------------------------------------------------------------
# A menu digit received this many seconds after the menu was shown is treated as a reply to the previous menu. 0 disables.
SMS_MENU_RACE_SECONDS=3

# --- Retention (days) -----------------------------------------------------------------------------------------
# Finished webhook deliveries (their bodies can hold message text), finished SMS/RCS outbound rows, and used or expired link tokens.
WEBHOOK_RETENTION_DAYS=30
OUTBOUND_RETENTION_DAYS=30
LINK_TOKEN_RETENTION_DAYS=7

# --- Rate limiting ----------------------------------------------------------------------------------------
# database = one atomic token bucket per key in the shared database: limits are global across instances (default in staging/production;
# needs the round-4 migration). memory = per instance, for development only. If the database is unreachable, one-time-code, link,
# household, enrollment and dashboard-auth limiters refuse requests and the rest fall back to a per-instance limiter.
# RATE_LIMIT_STORE=database

# --- Transactional email (dashboard verification codes and invitations) -----------------------------------
# POST EMAIL_API_URL with JSON {from,to,subject,text} and the key as "Authorization: Bearer <key>" (Resend works as is:
# https://api.resend.com/emails). All three or none; required in staging/production (https). Without them, development logs the
# message (code included) instead of sending it. See Server/README.md for other providers.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Only for providers that want the key elsewhere (an empty scheme sends the bare key):
# EMAIL_API_AUTH_HEADER=Authorization
# EMAIL_API_AUTH_SCHEME=Bearer

# --- Business dashboard / operator console ---------------------------------------------------------------
# Optional separate origin for dashboard passkeys (same RP_ID), e.g. https://business.viadere.com. Cookies are __Host- (HTTPS only).
DASHBOARD_ORIGIN=
DASHBOARD_IDLE_MINUTES=30
DASHBOARD_ABSOLUTE_HOURS=12

# --- Trust and abuse thresholds (auto-throttle) ---------------------------------------------------------
ABUSE_COMPLAINT_RATE=0.02
ABUSE_OPTOUT_RATE=0.10
ABUSE_MIN_SAMPLE=20
ABUSE_WINDOW_DAYS=7
ABUSE_THROTTLE_FACTOR=0.25

# --- Apple Wallet passes (optional: all four or none) ----------------------------------------------------
# Pass Type ID certificate + unencrypted private key (PEM) and Apple's WWDR intermediate. Prefer *_PATH to mounted secrets.
# Never commit these. Unset = passes disabled (the pass endpoints answer 501).
PASS_TYPE_IDENTIFIER=
PASS_CERTIFICATE_PATH=
PASS_PRIVATE_KEY_PATH=
PASS_WWDR_CERTIFICATE_PATH=

# --- Billing preview (micro-USD; transport rates default to 0 so previews never imply a price) -------------
BILLING_INCLUDED_INTERACTIONS=1000
BILLING_PLATFORM_MICROS_PER_INTERACTION=5000
BILLING_TRANSPORT_MICROS_PER_SMS_SEGMENT=0
BILLING_TRANSPORT_MICROS_PER_RCS_MESSAGE=0

# --- Runtime -------------------------------------------------------------------------------------------
LOG_LEVEL=info
PORT=8080
# Number of reverse proxies in front of the server (trusts that many X-Forwarded-For hops). 0 = ignore the header.
TRUSTED_PROXY_COUNT=0
# Comma-separated exact origins allowed by CORS. Empty (default) = no cross-origin access.
CORS_ALLOWED_ORIGINS=
RUN_BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=5
MAX_BODY_BYTES=65536
FREE_DAILY_INTERACTION_QUOTA=1000
# Development only: allow http:// and localhost webhook targets.
ALLOW_INSECURE_WEBHOOKS=false
