# Copy to .env and fill in. NEVER commit a real .env, .p8 key or auth token.
# Generate secrets with:   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

# development | testing | production. `production` makes every secret below mandatory and refuses `seed`.
ENVIRONMENT=development

# --- Database ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
# docker-compose derives DATABASE_URL from the password above. For other setups set it yourself:
# DATABASE_URL=postgres://viadere:PASSWORD@host:5432/viadere
AUTO_MIGRATE=true

# --- Secrets (base64url, >= 32 bytes each; independent random values) -----------------------------
# HMAC key for signed connect links (QR / buttons).
CONNECT_LINK_SIGNING_KEY=
# Pepper for OTP hashes, phone-number lookup hashes and per-business pseudonyms.
SERVER_PEPPER=
# AES-256-GCM key for phone numbers, message bodies, webhook secrets and SMS conversation state.
# Losing this key makes that data unreadable; rotating it needs a re-encryption job.
DATA_ENCRYPTION_KEY=

# --- Public URL / passkeys -------------------------------------------------------------------------
PUBLIC_BASE_URL=https://viadere.com
RP_ID=viadere.com
RP_NAME=Viadere
RP_ORIGIN=https://viadere.com
# 10-character Apple Developer Team ID (served in /.well-known/apple-app-site-association).
APPLE_TEAM_ID=
# Numeric App Store id; enables the Smart App Banner on /c/{code}.
APP_STORE_ID=

# --- Push (APNs token auth) -------------------------------------------------------------------------
# Either paste the .p8 contents (use \n for newlines) or mount the file and give its path.
APNS_KEY_P8=
# APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.viadere.app
# sandbox | production
APNS_ENVIRONMENT=sandbox

# --- SMS provider (Twilio-compatible) ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these two:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- RCS Business Messaging (generic RBM-style provider; leave unset to disable RCS -> SMS only) ----------
# Provider API origin (https in production), bearer token, agent id, and the shared secret (base64url, >= 32 bytes)
# used to verify the inbound webhook HMAC (X-RCS-Signature: t=...,v1=...).
RCS_PROVIDER_BASE_URL=
RCS_PROVIDER_TOKEN=
RCS_AGENT_ID=
RCS_WEBHOOK_SECRET=
# Apple Messages for Business is a non-functional placeholder. Keep this false until Apple approves multi-merchant brokerage in writing.
FEATURE_APPLE_MESSAGES_FOR_BUSINESS=false

# --- Business dashboard / operator console ---------------------------------------------------------------
# Optional separate origin for dashboard passkeys (same RP_ID), e.g. https://business.viadere.com. Cookies are __Host- (HTTPS only).
DASHBOARD_ORIGIN=
DASHBOARD_IDLE_MINUTES=30
DASHBOARD_ABSOLUTE_HOURS=12

# --- Trust and abuse thresholds (auto-throttle) ---------------------------------------------------------
ABUSE_COMPLAINT_RATE=0.02
ABUSE_OPTOUT_RATE=0.10
ABUSE_MIN_SAMPLE=20
ABUSE_WINDOW_DAYS=7
ABUSE_THROTTLE_FACTOR=0.25

# --- Billing preview (micro-USD; transport rates default to 0 so previews never imply a price) -------------
BILLING_INCLUDED_INTERACTIONS=1000
BILLING_PLATFORM_MICROS_PER_INTERACTION=5000
BILLING_TRANSPORT_MICROS_PER_SMS_SEGMENT=0
BILLING_TRANSPORT_MICROS_PER_RCS_MESSAGE=0

# --- Runtime -------------------------------------------------------------------------------------------
LOG_LEVEL=info
PORT=8080
# Number of reverse proxies in front of the server (trusts that many X-Forwarded-For hops). 0 = ignore the header.
TRUSTED_PROXY_COUNT=0
# Comma-separated exact origins allowed by CORS. Empty (default) = no cross-origin access.
CORS_ALLOWED_ORIGINS=
RUN_BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=5
MAX_BODY_BYTES=65536
FREE_DAILY_INTERACTION_QUOTA=1000
# Development only: allow http:// and localhost webhook targets.
ALLOW_INSECURE_WEBHOOKS=false
